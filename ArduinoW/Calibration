  while (currentKg < targetKg) {
    server.handleClient();
    uint16_t currentBtnState = readShiftRegister(); bool bCancel = (currentBtnState & (1 << 3)); 
    if (bCancel && !(lastBtnState & (1 << 3))) { cancelDebounce = millis(); }
    if (bCancel && cancelDebounce > 0 && (millis() - cancelDebounce > 100)) { cancelRequested = true; break; }
    lastBtnState = currentBtnState;

    if (!scale.is_ready()) { if (millis() - lastDispPrint >= 200) { lastDispPrint = millis(); Serial.println("HX711 BLINDED BY NOISE"); } } 
    else {
      currentKg = readLoadCellKg();
      if (millis() - lastDispPrint >= 200) { lastDispPrint = millis(); Serial.print("Weighing: "); Serial.print(currentKg, 3); Serial.print(" / "); Serial.print(targetKg, 3); Serial.println(" kg"); }
    }
    updateDispensingProgress(currentKg, targetKg); delay(20);
    if (millis() - startTime > 60000) break;
  }
  activeServo->write(HATCH_CLOSED); 
  tft.init(); tft.setRotation(3); 

  if (cancelRequested) {
    tft.fillScreen(TFT_WHITE); tft.fillRect(0, 0, 480, 60, TFT_RED); tft.setTextColor(TFT_WHITE); tft.setTextSize(3); tft.setCursor(15, 18); tft.print("Cancelled");
    tft.setTextColor(TFT_RED); tft.setTextSize(3); tft.setCursor(100, 150); tft.print("Dispensing"); tft.setCursor(120, 190); tft.print("Cancelled!");
    tft.setTextColor(TFT_BLACK); tft.setTextSize(2); tft.setCursor(90, 240); tft.print("Returning to menu...");
    delay(2000); selectedVariety = ""; selectedKilo = 0; selectedPricePerKg = 0; currentState = STATE_IDLE; drawIdleScreen(); return;
  }

  currentState = STATE_DONE; drawDoneScreen(); delay(3000);
  selectedVariety = ""; selectedKilo = 0; selectedPricePerKg = 0; currentState = STATE_IDLE; drawIdleScreen();
}

