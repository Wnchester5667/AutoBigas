float getDistanceCM(int trigPin, int echoPin) {
  digitalWrite(trigPin, LOW); delayMicroseconds(2);
  digitalWrite(trigPin, HIGH); delayMicroseconds(10);
  digitalWrite(trigPin, LOW);
  long duration = pulseIn(echoPin, HIGH, 30000);
  if (duration == 0) return -1.0; 
  float distance = (duration * 0.0343) / 2.0;
  if (distance < 2.0) return -1.0; 
  if (distance > 400) return 400.0;
  return distance;
}

float distanceToKg(float distance) {
  if (distance <= BIN_FULL_DISTANCE) return MAX_KG;
  if (distance >= BIN_EMPTY_DISTANCE) return 0;
  return ((BIN_EMPTY_DISTANCE - distance) / (BIN_EMPTY_DISTANCE - BIN_FULL_DISTANCE)) * MAX_KG;
}

void checkUltrasonic() {
  if (millis() - lastUltrasonicCheck < ultrasonicInterval) return;
  lastUltrasonicCheck = millis();
  
  float d1 = getDistanceCM(TRIG_JASMINE, ECHO_JASMINE);
  if (d1 < 0) { errJasmine = true; jasmineKg = -1; } else { errJasmine = false; jasmineKg = distanceToKg(d1); }

  float d2 = getDistanceCM(TRIG_SINANDOMENG, ECHO_SINANDOMENG);
  if (d2 < 0) { errSinandomeng = true; sinandomengKg = -1; } else { errSinandomeng = false; sinandomengKg = distanceToKg(d2); }

  float d3 = getDistanceCM(TRIG_DINORADO, ECHO_DINORADO);
  if (d3 < 0) { errDinorado = true; dinoradoKg = -1; } else { errDinorado = false; dinoradoKg = distanceToKg(d3); }
}

void checkLoadCell() {
  if (millis() - lastLoadCellCheck < loadCellCheckInterval) return;
  lastLoadCellCheck = millis();
  
  if (scale.is_ready()) {
    loadCellFailCount = 0;
    if (errLoadCell) Serial.println(F("HX711 recovered - scale OK again."));
    errLoadCell = false;
    return;
  }

  loadCellFailCount++;
  scale.power_down();
  delay(5);
  scale.power_up();
  delay(150); 
  
  if (scale.is_ready()) {
    loadCellFailCount = 0;
    errLoadCell = false;
    Serial.println(F("HX711 recovered after hard reset."));
    return;
  }
  
  if (loadCellFailCount >= 3) errLoadCell = true;
}

void printLoadCellReading() {
  if (millis() - lastLoadCellPrint < loadCellPrintInterval) return;
  lastLoadCellPrint = millis(); loadCellKg = readLoadCellKg();
  if (calStage == 1 || calStage == 2) return;
  Serial.print("Current Weight: "); Serial.print(loadCellKg, 3); Serial.println(" kg");
}

