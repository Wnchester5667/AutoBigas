uint16_t readShiftRegister() {
  uint16_t v1 = 0, v2 = 0, v3 = 0;
  digitalWrite(SR_PL, LOW); delayMicroseconds(10); digitalWrite(SR_PL, HIGH); delayMicroseconds(10);
  for (int i = 0; i < 8; i++) { digitalWrite(SR_CLK, LOW); delayMicroseconds(5); v1 = (v1 << 1) | digitalRead(SR_DATA); digitalWrite(SR_CLK, HIGH); delayMicroseconds(5); }
  digitalWrite(SR_PL, LOW); delayMicroseconds(10); digitalWrite(SR_PL, HIGH); delayMicroseconds(10);
  for (int i = 0; i < 8; i++) { digitalWrite(SR_CLK, LOW); delayMicroseconds(5); v2 = (v2 << 1) | digitalRead(SR_DATA); digitalWrite(SR_CLK, HIGH); delayMicroseconds(5); }
  digitalWrite(SR_PL, LOW); delayMicroseconds(10); digitalWrite(SR_PL, HIGH); delayMicroseconds(10);
  for (int i = 0; i < 8; i++) { digitalWrite(SR_CLK, LOW); delayMicroseconds(5); v3 = (v3 << 1) | digitalRead(SR_DATA); digitalWrite(SR_CLK, HIGH); delayMicroseconds(5); }
  return (v1 & v2) | (v2 & v3) | (v3 & v1);
}

float stockFor(String v) {
  if (v == "Jasmine") return jasmineKg;
