void setup() {
  Serial.begin(115200); delay(500);
  tft.init(); tft.setRotation(3); tft.fillScreen(TFT_WHITE);
  pinMode(SERVO_JASMINE, OUTPUT); digitalWrite(SERVO_JASMINE, LOW);
  pinMode(SERVO_SINANDOMENG, OUTPUT); digitalWrite(SERVO_SINANDOMENG, LOW);
  pinMode(SERVO_DINORADO, OUTPUT); digitalWrite(SERVO_DINORADO, LOW);
  servoJasmine.attach(SERVO_JASMINE); servoSinandomeng.attach(SERVO_SINANDOMENG); servoDinorado.attach(SERVO_DINORADO);
  servoJasmine.write(HATCH_CLOSED); servoSinandomeng.write(HATCH_CLOSED); servoDinorado.write(HATCH_CLOSED);
  pinMode(SR_PL, OUTPUT); pinMode(SR_CLK, OUTPUT); pinMode(SR_DATA, INPUT); digitalWrite(SR_PL, HIGH); digitalWrite(SR_CLK, LOW);
  pinMode(TRIG_JASMINE, OUTPUT); pinMode(ECHO_JASMINE, INPUT);
  pinMode(TRIG_SINANDOMENG, OUTPUT); pinMode(ECHO_SINANDOMENG, INPUT);
  pinMode(TRIG_DINORADO, OUTPUT); pinMode(ECHO_DINORADO, INPUT);
  
  scale.begin(HX711_DT, HX711_SCK);
  
  // --- CRITICAL BOOT FIX: Force a clean wake-up state for the HX711 chip ---
  scale.power_down(); 
  delay(10);
  scale.power_up();
  delay(200); // Give the chip 200ms to complete its very first conversion

  unsigned long st = millis(); 
  while (!scale.is_ready() && millis() - st < 3000) { 
    delay(10); 
  }
  
  if (scale.is_ready()) { 
    scale.set_scale(calibrationFactor); 
    scale.tare(); 
    errLoadCell = false;
    Serial.println("HX711 initialized successfully at boot.");
  } else {
    errLoadCell = true;
    loadCellFailCount = 5;
    Serial.println("WARNING: HX711/Load Cell not detected at boot!");
  }
  
  WiFi.softAP(ssid, password);
  server.on("/", []() { server.send_P(200, "text/html", index_html); });
  server.on("/sensors", handleSensors);
  server.begin();
  drawIdleScreen(); lastDebounce = millis();
  Serial.println("SYSTEM READY"); delay(1000);
}

void loop() {
  server.handleClient(); handleCalibrationInput();
  if (remoteDispenseRequested && currentState == STATE_IDLE) { remoteDispenseRequested = false; triggerRemoteDispense(remoteCompartment, remoteWeight); }
  uint16_t buttons = readShiftRegister();
  if (buttons != lastButtons) { lastButtons = buttons; }
  bool btnJasmine = (buttons & (1 << 0)); bool btnSinandomeng = (buttons & (1 << 1)); bool btnDinorado = (buttons & (1 << 2));
  bool btnCancel = (buttons & (1 << 3)); bool btnConfirm = (buttons & (1 << 4));
  bool btnIncrement = (buttons & (1 << 5)); bool btnDecrement = (buttons & (1 << 6));
  switch (currentState) {
    case STATE_IDLE: checkVarietyButtons(btnJasmine, btnSinandomeng, btnDinorado); break;
    case STATE_VARIETY_SELECTED: checkWeightButtons(btnIncrement, btnDecrement); checkCancelButton(btnCancel); checkConfirmButton(btnConfirm); break;
    case STATE_READY: checkCancelButton(btnCancel); checkConfirmButton(btnConfirm); break;
  }
  checkUltrasonic();
  checkLoadCell();
  if (currentState == STATE_IDLE) printLoadCellReading();
}
