// --- CRITICAL FIX: STOP FREEZING THE ESP32 ---
float readLoadCellKg() {
  static float candidateKg = -1.0;
  static byte candidateCount = 0;
  
  if (!scale.is_ready()) {
      return lastGoodKg; 
  }

  // FIX: get_units(1) instead of get_units(10). 
  // 10 readings blocked the ESP32 for 1 full second, causing boot errors and WiFi timeouts!
  float grams = scale.get_units(1); 
  if (grams < 0) grams = 0;
  float currentKg = grams / 1000.0;
  float difference = abs(currentKg - lastGoodKg);
  
  if (difference < 0.500) { 
    lastGoodKg = currentKg; 
    candidateKg = -1.0; 
    candidateCount = 0; 
    return currentKg; 
  } else {
    if (candidateKg >= 0.0 && abs(currentKg - candidateKg) < 0.050) { 
      candidateCount++; 
      if (candidateCount >= 3) { 
        lastGoodKg = currentKg; 
        candidateKg = -1.0; 
        candidateCount = 0; 
        return lastGoodKg; 
      } 
    } else { 
      candidateKg = currentKg; 
      candidateCount = 1; 
    }
  }
  return lastGoodKg;
}

void processCalCommand(String cmd) {
  cmd.trim();
  if (cmd == "c" || cmd == "C") { calStage = 1; Serial.println(F("=== LOAD CELL CALIBRATION MODE ===")); Serial.println(F("Step 1: Remove ALL weight.")); Serial.println(F("Step 2: Send 't'")); } 
  else if (cmd == "t" || cmd == "T") {
    if (calStage >= 1) {
      Serial.println(F("Taring...")); unsigned long timeout = millis() + 3000;
      while (!scale.is_ready() && millis() < timeout) { delay(10); }
      if (scale.is_ready()) { scale.tare(); calStage = 2; Serial.println(F("Tared OK. Place known weight and send grams.")); } 
      else { Serial.println(F("HX711 not responding!")); calStage = 0; }
    }
  } 
  else if (cmd == "x" || cmd == "X") { calStage = 0; Serial.println(F("Calibration mode OFF.")); } 
  else if (calStage == 2) {
    float grams = cmd.toFloat();
    if (grams <= 1.0) { Serial.println(F("Send valid grams > 1")); } 
    else {
      Serial.println(F("Reading... hold still...")); delay(2000); 
      if (!scale.is_ready()) { scale.power_down(); delay(5); scale.power_up(); delay(150); }
      if (scale.is_ready()) {
        long raw = (long)scale.get_value(20); float newFactor = (float)raw / grams; scale.set_scale(newFactor);
        Serial.print(F(">>> NEW calibrationFactor = ")); Serial.println(newFactor, 2);
        Serial.println(F(">>> Paste into code. Send 'x' when done.")); calStage = 3;
      }
    }
  }
}

void handleCalibrationInput() {
  while (Serial.available() > 0) {
    char c = (char)Serial.read();
    if (c == '\n' || c == '\r') { if (calBuffer.length() > 0) { processCalCommand(calBuffer); calBuffer = ""; } } 
    else { calBuffer += c; if (calBuffer.length() > 32) calBuffer = ""; }
  }
}

