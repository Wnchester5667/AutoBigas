<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Autobigas.Connect</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        body { background-color: #f4f7f6; color: #333; min-height: 100vh; }
        .hidden { display: none !important; }

        .dashboard-header { background: #2c3e50; color: white; padding: 18px 30px; display: flex; justify-content: space-between; align-items: center; box-shadow: 0 4px 6px rgba(0,0,0,0.1); gap: 15px; flex-wrap: wrap; }
        .header-logo { font-size: 22px; font-weight: 800; }
        .header-logo span { color: #e67e22; }
        .dashboard-content { padding: 20px; max-width: 1300px; margin: 0 auto; }
        .section-title { font-size: 20px; font-weight: 700; color: #2c3e50; margin: 20px 0; border-bottom: 2px solid #e0e6ed; padding-bottom: 10px; }
        .connection-card { background: white; padding: 20px; border-radius: 12px; box-shadow: 0 5px 15px rgba(0,0,0,0.05); margin-bottom: 20px; }
        .connection-card h3 { color: #2c3e50; margin-bottom: 10px; }
        .connection-row { display: flex; gap: 10px; margin-top: 15px; flex-wrap: wrap; }
        .connection-row input { flex: 1; min-width: 220px; padding: 12px; border: 2px solid #e0e6ed; border-radius: 8px; outline: none; }
        .connection-row input:focus { border-color: #e67e22; }
        .connection-row button { padding: 12px 18px; background: #2c3e50; color: white; border: none; border-radius: 8px; cursor: pointer; font-weight: 600; }
        .connection-row button:hover { background: #e67e22; }
        .esp-note { font-size: 13px; color: #7f8c8d; line-height: 1.6; margin-top: 10px; }
        #flowStatus { font-weight: 700; color: #2c3e50; background: #f8f9fa; padding: 8px 12px; border-radius: 6px; border-left: 4px solid #e67e22; display: block; margin-top: 10px; }

        .compartments-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px; margin-bottom: 20px; }
        .comp-card { background: white; border-radius: 12px; padding: 20px; box-shadow: 0 5px 15px rgba(0,0,0,0.05); display: flex; flex-direction: column; align-items: center; border-top: 5px solid #2ecc71; }
        .comp-card.warning { border-top-color: #f39c12; }
        .comp-card.danger { border-top-color: #e74c3c; }
        .comp-card.waiting { border-top-color: #95a5a6; }
        .comp-card.error { border-top-color: #8e44ad; }

        .comp-title { font-size: 18px; font-weight: 700; color: #2c3e50; margin-bottom: 5px; }
        .comp-rice-type { font-size: 13px; color: #7f8c8d; margin-bottom: 15px; }
        .tank-container { display: flex; align-items: flex-end; gap: 20px; width: 100%; margin-bottom: 15px; }
        .tank { width: 60px; height: 150px; border: 3px solid #34495e; border-radius: 0 0 15px 15px; position: relative; background: #ecf0f1; overflow: hidden; flex-shrink: 0; }
        .tank-fill { position: absolute; bottom: 0; width: 100%; background: #2ecc71; transition: height 0.5s ease; }
        .tank.warning .tank-fill { background: #f39c12; }
        .tank.danger .tank-fill { background: #e74c3c; }
        .tank.waiting .tank-fill { background: #bdc3c7; }
        .tank.error .tank-fill { background: #8e44ad; }

        .tank-data { flex: 1; text-align: left; }
        .tank-weight { font-size: 28px; font-weight: 800; color: #2c3e50; }
        .tank-max { font-size: 14px; color: #7f8c8d; }
        .tank-percent { font-size: 16px; font-weight: 600; margin-top: 5px; }
        .report-summary { width: 100%; background: #f8f9fa; padding: 12px; border-radius: 8px; font-size: 13px; color: #555; text-align: left; line-height: 1.6; margin-bottom: 10px; }
        .status-badge { display: inline-block; padding: 4px 10px; border-radius: 20px; font-size: 12px; font-weight: 700; color: white; margin-bottom: 8px; }
        .badge-safe { background: #2ecc71; }
        .badge-low { background: #f39c12; }
        .badge-critical { background: #e74c3c; animation: pulse 1.5s infinite; }
        .badge-waiting { background: #95a5a6; }
        .badge-error { background: #8e44ad; animation: pulse 1.5s infinite; }
        @keyframes pulse { 0% { opacity: 1; } 50% { opacity: 0.6; } 100% { opacity: 1; } }

        .forecast-box { width: 100%; background: #e8f4fd; border: 1px dashed #3498db; border-radius: 8px; padding: 12px; margin-bottom: 15px; font-size: 12px; color: #1f618d; text-align: left; line-height: 1.6; }
        .forecast-item { display: block; margin-top: 4px; }
        .forecast-item strong { color: #2980b9; }

        .dispense-controls { display: flex; gap: 10px; width: 100%; margin-top: 10px; }
        .dispense-select { flex: 1; padding: 12px; border: 2px solid #e0e6ed; border-radius: 8px; font-size: 15px; font-weight: 600; outline: none; background: white; color: #2c3e50; }
        .btn-dispense { flex: 1.2; padding: 12px; background: #3498db; color: white; border: none; border-radius: 8px; font-weight: 600; font-size: 15px; cursor: pointer; }
        .btn-dispense:hover { background: #2980b9; }
        .btn-dispense:disabled { background: #bdc3c7; cursor: not-allowed; }
        .dispense-status { margin-top: 10px; font-size: 14px; font-weight: 700; height: 20px; text-align: center; }
        .dispensing { color: #e67e22; animation: pulse 1s infinite; }
        .done { color: #2ecc71; }
        .error-text { color: #e74c3c; }

        .budget-controls { display: flex; gap: 10px; width: 100%; margin-top: 10px; }
        .budget-input { flex: 1; padding: 12px; border: 2px solid #e0e6ed; border-radius: 8px; font-size: 15px; font-weight: 600; outline: none; background: white; color: #2c3e50; }
        .budget-input:focus { border-color: #e67e22; }
        .btn-budget { flex: 1.2; padding: 12px; background: #e67e22; color: white; border: none; border-radius: 8px; font-weight: 600; font-size: 14px; cursor: pointer; }
        .btn-budget:hover { background: #d35400; }
        .btn-budget:disabled { background: #bdc3c7; cursor: not-allowed; }

        .alerts-panel { background: #fff3cd; border: 1px solid #ffeeba; border-left: 5px solid #e74c3c; padding: 20px; border-radius: 8px; margin-top: 20px; }
        .alerts-panel h3 { color: #856404; margin-bottom: 10px; }
        .alert-item { background: white; padding: 12px; border-radius: 6px; margin-top: 10px; border: 1px solid #ffeeba; font-size: 14px; color: #333; line-height: 1.5; }
        .alert-time { font-size: 12px; color: #999; display: block; margin-top: 5px; }
    </style>
</head>
<body>

<div id="dashboardPage">
    <header class="dashboard-header">
        <div class="header-logo">Auto<span>bigas</span>.Connect</div>
    </header>

    <main class="dashboard-content">
        <div class="connection-card">
            <h3>ESP32 Local Connection (AP Mode)</h3>
            <span id="espStatus" class="status-badge badge-waiting">Waiting</span>
            <span id="flowStatus">Step: —</span>
            <p class="esp-note">
                1. Power on the rice dispenser (ESP32).<br>
                2. Connect this device to WiFi: <strong>Autobigas.Connect</strong>.<br>
                3. Default ESP32 address: <code>http://192.168.4.1/sensors</code>
            </p>
            <div class="connection-row">
                <input type="text" id="espUrl" placeholder="http://192.168.4.1/sensors">
                <button onclick="saveAndConnect()">Save & Connect</button>
            </div>
        </div>

        <h2 class="section-title">Compartment Monitoring & Remote Dispense</h2>
        <div class="compartments-grid">

            <div class="comp-card waiting" id="compCard1">
                <div class="comp-title">Compartment 1</div>
                <div class="comp-rice-type">Jasmine</div>
                <div class="tank-container">
                    <div class="tank waiting" id="tank1"><div class="tank-fill" id="tankFill1" style="height: 0%;"></div></div>
                    <div class="tank-data">
                        <div class="tank-weight"><span id="weight1">0.0</span> <span style="font-size:16px;">kg</span></div>
                        <div class="tank-max">/ 10.0 kg max</div>
                        <div class="tank-percent" id="percent1" style="color:#95a5a6;">0% Full</div>
                    </div>
                </div>
                <div class="forecast-box">
                    <strong>📊 Depletion Forecast (Regression Model):</strong>
                    <span class="forecast-item">⏱️ Time to Low (3kg / 30%): <span id="forecastWarn1">--</span></span>
                    <span class="forecast-item">⏱️ Time to Critical (1kg / 10%): <span id="forecastCrit1">--</span></span>
                </div>
                <div class="report-summary">
                    <span class="status-badge badge-waiting" id="statusBadge1">WAITING</span><br>
                    <strong>Sensor Report:</strong> <span id="report1">Waiting for ESP32 data.</span>
                </div>
                <div class="dispense-controls">
                    <input type="number" class="dispense-select" id="dispenseWeight1" min="0.1" max="5" step="0.1" value="1.0" placeholder="kg">
                    <button class="btn-dispense" id="dispenseBtn1" onclick="triggerDispense(1)">🔄 Dispense</button>
                </div>
                <div class="dispense-status" id="dispenseStatus1"></div>
                <div class="budget-controls">
                    <input type="number" class="budget-input" id="budgetMoney1" placeholder="₱ money given" min="0" step="any">
                    <button class="btn-budget" id="budgetBtn1" onclick="budgetDispense(1)">💰 By Budget</button>
                </div>
            </div>

            <div class="comp-card waiting" id="compCard2">
                <div class="comp-title">Compartment 2</div>
                <div class="comp-rice-type">Sinandomeng</div>
                <div class="tank-container">
                    <div class="tank waiting" id="tank2"><div class="tank-fill" id="tankFill2" style="height: 0%;"></div></div>
                    <div class="tank-data">
                        <div class="tank-weight"><span id="weight2">0.0</span> <span style="font-size:16px;">kg</span></div>
                        <div class="tank-max">/ 10.0 kg max</div>
                        <div class="tank-percent" id="percent2" style="color:#95a5a6;">0% Full</div>
                    </div>
                </div>
                <div class="forecast-box">
                    <strong>📊 Depletion Forecast (Regression Model):</strong>
                    <span class="forecast-item">⏱️ Time to Low (3kg / 30%): <span id="forecastWarn2">--</span></span>
                    <span class="forecast-item">⏱️ Time to Critical (1kg / 10%): <span id="forecastCrit2">--</span></span>
                </div>
                <div class="report-summary">
                    <span class="status-badge badge-waiting" id="statusBadge2">WAITING</span><br>
                    <strong>Sensor Report:</strong> <span id="report2">Waiting for ESP32 data.</span>
                </div>
                <div class="dispense-controls">
                    <input type="number" class="dispense-select" id="dispenseWeight2" min="0.1" max="5" step="0.1" value="1.0" placeholder="kg">
                    <button class="btn-dispense" id="dispenseBtn2" onclick="triggerDispense(2)">🔄 Dispense</button>
                </div>
                <div class="dispense-status" id="dispenseStatus2"></div>
                <div class="budget-controls">
                    <input type="number" class="budget-input" id="budgetMoney2" placeholder="₱ money given" min="0" step="any">
                    <button class="btn-budget" id="budgetBtn2" onclick="budgetDispense(2)">💰 By Budget</button>
                </div>
            </div>

            <div class="comp-card waiting" id="compCard3">
                <div class="comp-title">Compartment 3</div>
                <div class="comp-rice-type">Dinorado</div>
                <div class="tank-container">
                    <div class="tank waiting" id="tank3"><div class="tank-fill" id="tankFill3" style="height: 0%;"></div></div>
                    <div class="tank-data">
                        <div class="tank-weight"><span id="weight3">0.0</span> <span style="font-size:16px;">kg</span></div>
                        <div class="tank-max">/ 10.0 kg max</div>
                        <div class="tank-percent" id="percent3" style="color:#95a5a6;">0% Full</div>
                    </div>
                </div>
                <div class="forecast-box">
                    <strong>📊 Depletion Forecast (Regression Model):</strong>
                    <span class="forecast-item">⏱️ Time to Low (3kg / 30%): <span id="forecastWarn3">--</span></span>
                    <span class="forecast-item">⏱️ Time to Critical (1kg / 10%): <span id="forecastCrit3">--</span></span>
                </div>
                <div class="report-summary">
                    <span class="status-badge badge-waiting" id="statusBadge3">WAITING</span><br>
                    <strong>Sensor Report:</strong> <span id="report3">Waiting for ESP32 data.</span>
                </div>
                <div class="dispense-controls">
                    <input type="number" class="dispense-select" id="dispenseWeight3" min="0.1" max="5" step="0.1" value="1.0" placeholder="kg">
                    <button class="btn-dispense" id="dispenseBtn3" onclick="triggerDispense(3)">🔄 Dispense</button>
                </div>
                <div class="dispense-status" id="dispenseStatus3"></div>
                <div class="budget-controls">
                    <input type="number" class="budget-input" id="budgetMoney3" placeholder="₱ money given" min="0" step="any">
                    <button class="btn-budget" id="budgetBtn3" onclick="budgetDispense(3)">💰 By Budget</button>
                </div>
            </div>

        </div>

        <h2 class="section-title">System Alerts & Warnings</h2>
        <div class="alerts-panel">
            <h3>⚠️ System Alerts & Warnings</h3>
            <div id="alertsList">
                <div class="alert-item">No active warnings. System is waiting for ESP32 sensor data.</div>
            </div>
        </div>
    </main>
</div>

<script>
    const ESP_URL_KEY = "autobigas_esp32_url";
    const MAX_KG = 10.0;
    const MAX_DISPENSE_KG = 5.0;
    const DANGER_THRESHOLD = 1.0;
    const LOW_THRESHOLD = 3.0;

    const PRICES = { "Jasmine": 58.0, "Sinandomeng": 52.0, "Dinorado": 55.0 };
    const DEPLETION_RATES = { "Jasmine": 0.5022, "Dinorado": 0.3717, "Sinandomeng": 0.3007 };

    const DEFAULT_ESP32_URL = "http://192.168.4.1/sensors";
    const REFRESH_INTERVAL = 2000;
    const RETRY_INTERVAL = 5000;
    const POLL_TIMEOUT = 4000;
    const MAX_MISSED_POLLS = 3;
    const DISPENSE_TIMEOUT = 60000;

    let compartments = [
        { id: 1, name: "Compartment 1", rice: "Jasmine", kg: null, hasError: false },
        { id: 2, name: "Compartment 2", rice: "Sinandomeng", kg: null, hasError: false },
        { id: 3, name: "Compartment 3", rice: "Dinorado", kg: null, hasError: false }
    ];

    let loadCellError = false;

    let monitoringTimer = null;
    let retryTimer = null;
    let appRunning = true;
    let alertedCompartments = {};
    let session = 0;
    let missedPolls = 0;
    let dispensing = false;

    function setEspStatus(text, status) {
        const badge = document.getElementById("espStatus");
        badge.textContent = text;
        badge.className = "status-badge badge-" + status;
    }
    function setFlowStatus(text) { document.getElementById("flowStatus").textContent = text; }

    function getEspUrl() {
        const saved = (localStorage.getItem(ESP_URL_KEY) || "").trim();
        return saved !== "" ? saved : DEFAULT_ESP32_URL;
    }
    function stopTimers() {
        if (monitoringTimer) { clearTimeout(monitoringTimer); monitoringTimer = null; }
        if (retryTimer) { clearTimeout(retryTimer); retryTimer = null; }
    }
    function saveAndConnect() {
        localStorage.setItem(ESP_URL_KEY, document.getElementById("espUrl").value.trim());
        initializeAppAndNetwork();
    }

    function initializeAppAndNetwork() {
        if (!appRunning) return;
        stopTimers();
        session++;
        missedPolls = 0;
        setFlowStatus("Step: Initiate App & Network");
        setEspStatus("Initializing...", "waiting");
        requestSensorData(session);
    }

    async function fetchSensors(timeoutMs) {
        const controller = new AbortController();
        const timer = setTimeout(() => controller.abort(), timeoutMs);
        try {
            const response = await fetch(getEspUrl(), { cache: "no-store", signal: controller.signal });
            if (!response.ok) throw new Error("HTTP " + response.status);
            return await response.json();
        } finally { clearTimeout(timer); }
    }

    async function requestSensorData(sess) {
        if (!appRunning || sess !== session) return;
        if (dispensing) { monitoringTimer = setTimeout(() => requestSensorData(sess), REFRESH_INTERVAL); return; }

        let data;
        try { data = await fetchSensors(POLL_TIMEOUT); }
        catch (error) {
            if (sess !== session) return;
            missedPolls++;
            if (missedPolls >= MAX_MISSED_POLLS) { connectionErrorDisplay(); }
            else {
                setEspStatus("Weak Link (" + missedPolls + "/" + MAX_MISSED_POLLS + ")", "low");
                setFlowStatus("Step: Missed reply, polling again...");
                monitoringTimer = setTimeout(() => requestSensorData(sess), REFRESH_INTERVAL);
            }
            return;
        }

        if (sess !== session) return;
        missedPolls = 0;
        setEspStatus("AP CONNECTED", "safe");
        setFlowStatus("Step: Live Sensor Data Received");

        try { handleSensorData(data); checkThresholds(); } catch (error) { console.error("Display error:", error); }

        setFlowStatus("Step: Delay Refresh Interval (" + (REFRESH_INTERVAL / 1000) + "s)");
        monitoringTimer = setTimeout(() => requestSensorData(sess), REFRESH_INTERVAL);
    }

    function connectionErrorDisplay() {
        setEspStatus("Connection Error", "danger");
        setFlowStatus("Step: Connection Error Display → Retrying...");
        retryTimer = setTimeout(initializeAppAndNetwork, RETRY_INTERVAL);
    }

    async function sendDispense(id, kg) {
        const url = getEspUrl().split('?')[0] + "?dispense=" + id + "&weight=" + kg;
        const controller = new AbortController();
        const timer = setTimeout(() => controller.abort(), DISPENSE_TIMEOUT);
        dispensing = true;
        try {
            const response = await fetch(url, { cache: "no-store", signal: controller.signal });
            if (!response.ok) return { ok: false, status: "http_error" };
            const data = await response.json();
            return { ok: true, status: data.status, available: data.available };
        } catch (e) {
            return { ok: false, status: "network_error" };
        } finally {
            clearTimeout(timer);
            dispensing = false;
        }
    }

    async function triggerDispense(id) {
        const inputEl = document.getElementById("dispenseWeight" + id);
        let weight = parseFloat(inputEl.value);
        const btn = document.getElementById("dispenseBtn" + id);
        const statusEl = document.getElementById("dispenseStatus" + id);
        const comp = compartments.find(c => c.id === id);

        if (isNaN(weight) || weight <= 0) {
            statusEl.textContent = "⚠️ Enter a valid weight (e.g., 1.5)"; statusEl.className = "dispense-status error-text";
            setTimeout(() => { statusEl.textContent = ""; statusEl.className = "dispense-status"; }, 3000); return;
        }
        if (weight > MAX_DISPENSE_KG) { weight = MAX_DISPENSE_KG; inputEl.value = MAX_DISPENSE_KG; }
        weight = Math.round(weight * 100) / 100;

        if (dispensing) {
            statusEl.textContent = "⚠️ Dispenser is busy, wait a moment"; statusEl.className = "dispense-status error-text";
            setTimeout(() => { statusEl.textContent = ""; statusEl.className = "dispense-status"; }, 3000); return;
        }
        if (loadCellError) {
            statusEl.textContent = "⚠️ SCALE ERROR: Cannot dispense without working scale";
            statusEl.className = "dispense-status error-text";
            setTimeout(() => { statusEl.textContent = ""; statusEl.className = "dispense-status"; }, 3000); return;
        }
        if (comp.hasError || (comp.kg !== null && weight > comp.kg)) {
            statusEl.textContent = comp.hasError ? "⚠️ SENSOR ERROR: Cannot dispense" : "⚠️ ERROR: Only " + comp.kg.toFixed(1) + "kg available!";
            statusEl.className = "dispense-status error-text";
            setTimeout(() => { statusEl.textContent = ""; statusEl.className = "dispense-status"; }, 3000); return;
        }

        btn.disabled = true;
        statusEl.textContent = "DISPENSING " + weight.toFixed(2) + "kg...";
        statusEl.className = "dispense-status dispensing";

        const result = await sendDispense(id, weight);
        if (result.ok && result.status === "dispensing") {
            statusEl.textContent = "DONE! (" + weight.toFixed(2) + "kg Dispensed)";
            statusEl.className = "dispense-status done";
        } else if (result.status === "scale_error") {
            statusEl.textContent = "⚠️ SCALE ERROR: Load cell disconnected or broken";
            statusEl.className = "dispense-status error-text";
        } else if (result.status === "insufficient_stock") {
            statusEl.textContent = "⚠️ INSUFFICIENT STOCK (" + result.available + "kg left)";
            statusEl.className = "dispense-status error-text";
        } else {
            statusEl.textContent = "⚠️ No confirmation from dispenser. Check the unit.";
            statusEl.className = "dispense-status error-text";
        }
        setTimeout(() => { statusEl.textContent = ""; statusEl.className = "dispense-status"; btn.disabled = false; }, result.ok ? 3000 : 6000);
    }

    async function budgetDispense(id) {
        const moneyEl = document.getElementById("budgetMoney" + id);
        const money = parseFloat(moneyEl.value);
        const btn = document.getElementById("budgetBtn" + id);
        const statusEl = document.getElementById("dispenseStatus" + id);
        const comp = compartments.find(c => c.id === id);

        if (!money || money <= 0) {
            statusEl.textContent = "⚠️ Enter a valid amount"; statusEl.className = "dispense-status error-text";
            setTimeout(() => { statusEl.textContent = ""; statusEl.className = "dispense-status"; }, 3000); return;
        }
        if (dispensing) {
            statusEl.textContent = "⚠️ Dispenser is busy, wait a moment"; statusEl.className = "dispense-status error-text";
            setTimeout(() => { statusEl.textContent = ""; statusEl.className = "dispense-status"; }, 3000); return;
        }
        if (loadCellError) {
            statusEl.textContent = "⚠️ SCALE ERROR: Cannot dispense without working scale";
            statusEl.className = "dispense-status error-text";
            setTimeout(() => { statusEl.textContent = ""; statusEl.className = "dispense-status"; }, 3000); return;
        }

        const price = PRICES[comp.rice];
        let kg = Math.floor((money / price) * 100) / 100;
        if (kg > MAX_DISPENSE_KG) kg = MAX_DISPENSE_KG;
        if (kg <= 0) {
            statusEl.textContent = "⚠️ Budget too small (min ₱" + price + ")"; statusEl.className = "dispense-status error-text";
            setTimeout(() => { statusEl.textContent = ""; statusEl.className = "dispense-status"; }, 3000); return;
        }

        const cost = Math.floor(kg * price * 100) / 100;
        const change = Math.round((money - cost) * 100) / 100;

        if (comp.hasError || (comp.kg !== null && kg > comp.kg)) {
            statusEl.textContent = comp.hasError ? "⚠️ SENSOR ERROR: Cannot dispense" : "⚠️ ERROR: Only " + comp.kg.toFixed(1) + "kg available!";
            statusEl.className = "dispense-status error-text";
            setTimeout(() => { statusEl.textContent = ""; statusEl.className = "dispense-status"; }, 3000); return;
        }

        btn.disabled = true;
        statusEl.textContent = "₱" + money + " → " + kg.toFixed(2) + "kg...";
        statusEl.className = "dispense-status dispensing";

        const result = await sendDispense(id, kg);
        if (result.ok && result.status === "dispensing") {
            statusEl.textContent = "✅ " + kg.toFixed(2) + "kg | cost ₱" + cost.toFixed(2) + " | change ₱" + change.toFixed(2);
            statusEl.className = "dispense-status done";
        } else if (result.status === "scale_error") {
            statusEl.textContent = "⚠️ SCALE ERROR: Load cell disconnected or broken";
            statusEl.className = "dispense-status error-text";
        } else if (result.status === "insufficient_stock") {
            statusEl.textContent = "⚠️ INSUFFICIENT STOCK (" + result.available + "kg left)";
            statusEl.className = "dispense-status error-text";
        } else {
            statusEl.textContent = "⚠️ No confirmation from dispenser. Check the unit.";
            statusEl.className = "dispense-status error-text";
        }
        setTimeout(() => { statusEl.textContent = ""; statusEl.className = "dispense-status"; btn.disabled = false; }, 6000);
    }

    function checkThresholds() {
        const critical = compartments.filter(c => c.kg !== null && c.kg <= DANGER_THRESHOLD && !c.hasError);
        if (critical.length > 0) { critical.forEach(c => lowStockAlert(c)); }
        else { compartments.forEach(c => { if(!c.hasError) alertedCompartments[c.id] = false; }); }
    }

    function lowStockAlert(comp) {
        if (alertedCompartments[comp.id]) return;
        alertedCompartments[comp.id] = true;
        try {
            if ("Notification" in window && Notification.permission === "granted") {
                new Notification("AutoBigas Connect — Low Stock Alert", {
                    body: comp.name + " (" + comp.rice + ") is at " + comp.kg.toFixed(1) + " kg (Below 1kg). Refill immediately."
                });
            }
        } catch (e) {}
    }

    window.addEventListener("beforeunload", function () { appRunning = false; stopTimers(); });

    function handleSensorData(data) {
        if (!data) return;
        if (typeof data.errLoadCell !== 'undefined') {
            loadCellError = data.errLoadCell === true;
        }
        if (Array.isArray(data) && data.length >= 3) {
            updateCompartment(1, data[0], false); updateCompartment(2, data[1], false); updateCompartment(3, data[2], false); return;
        }
        if ("compartment1" in data) {
            updateCompartment(1, data.compartment1, data.err1);
            updateCompartment(2, data.compartment2, data.err2);
            updateCompartment(3, data.compartment3, data.err3);
            return;
        }
        if ("comp1" in data) {
            updateCompartment(1, data.comp1, false); updateCompartment(2, data.comp2, false); updateCompartment(3, data.comp3, false); return;
        }
    }

    function updateForecast(id, currentPct) {
        const comp = compartments.find(c => c.id === id);
        const rate = DEPLETION_RATES[comp.rice];
        const warnEl = document.getElementById("forecastWarn" + id);
        const critEl = document.getElementById("forecastCrit" + id);
        if (currentPct === null || isNaN(currentPct)) { warnEl.textContent = "--"; critEl.textContent = "--"; return; }
        warnEl.textContent = currentPct > 30 ? Math.round((currentPct - 30) / rate) + " mins" : "Reached!";
        critEl.textContent = currentPct > 10 ? Math.round((currentPct - 10) / rate) + " mins" : "Reached!";
    }

    function updateCompartment(id, kg, hasError) {
        const comp = compartments.find(c => c.id === id);
        const card = document.getElementById("compCard" + id);
        const tank = document.getElementById("tank" + id);
        const fill = document.getElementById("tankFill" + id);
        const weight = document.getElementById("weight" + id);
        const percent = document.getElementById("percent" + id);
        const badge = document.getElementById("statusBadge" + id);
        const report = document.getElementById("report" + id);

        let status = "waiting", kgValue = 0, percentValue = 0;

        if (hasError) {
            status = "error";
            kgValue = 0;
            percentValue = 0;
            if (comp) { comp.kg = null; comp.hasError = true; }
            updateForecast(id, null);
        } else if (kg !== null && kg !== undefined && !isNaN(kg) && kg >= 0) {
            kgValue = Math.max(0, Math.min(MAX_KG, Number(kg)));
            percentValue = Math.round((kgValue / MAX_KG) * 100);
            if (kgValue <= DANGER_THRESHOLD) status = "danger";
            else if (kgValue <= LOW_THRESHOLD) status = "warning";
            else status = "safe";
            if (comp) { comp.kg = kgValue; comp.hasError = false; }
            updateForecast(id, percentValue);
        } else {
            if (comp) { comp.kg = null; comp.hasError = false; }
            updateForecast(id, null);
        }

        card.className = "comp-card " + status;
        tank.className = "tank " + status;
        fill.style.height = percentValue + "%";
        weight.textContent = kgValue.toFixed(1);
        percent.textContent = percentValue + "% Full";

        if (status === "safe") percent.style.color = "#2ecc71";
        else if (status === "warning") percent.style.color = "#f39c12";
        else if (status === "danger") percent.style.color = "#e74c3c";
        else if (status === "error") percent.style.color = "#8e44ad";
        else percent.style.color = "#95a5a6";

        if (status === "error") {
            badge.textContent = "SENSOR ERROR";
            badge.className = "status-badge badge-error";
            report.textContent = "⚠️ Ultrasonic sensor disconnected, miscalibrated, or malfunctioning. Check wiring.";
        } else if (status === "waiting") {
            badge.textContent = "WAITING"; badge.className = "status-badge badge-waiting";
            report.textContent = "Waiting for HC-SR04 / ESP32 data. No measurement received yet.";
        } else if (status === "safe") {
            badge.textContent = "SAFE"; badge.className = "status-badge badge-safe";
            report.textContent = "Sensor reading normal. Current estimated weight is " + kgValue.toFixed(1) + " kg.";
        } else if (status === "warning") {
            badge.textContent = "LOW (30%)"; badge.className = "status-badge badge-low";
            report.textContent = "Rice level is low at " + kgValue.toFixed(1) + " kg. Prepare refill soon.";
        } else if (status === "danger") {
            badge.textContent = "CRITICAL (10%)"; badge.className = "status-badge badge-critical";
            report.textContent = "Level is " + kgValue.toFixed(1) + " kg, below the 1.0 kg threshold. Refill immediately.";
        }
        renderAlerts();
    }

    function renderAlerts() {
        const list = document.getElementById("alertsList");
        list.innerHTML = "";
        const hasData = compartments.some(c => c.kg !== null || c.hasError) || loadCellError;
        if (!hasData) { list.innerHTML = '<div class="alert-item">No active warnings. System is waiting for ESP32 sensor data.</div>'; return; }
        let hasAlert = false;

        if (loadCellError) {
            hasAlert = true;
            list.insertAdjacentHTML("beforeend", '<div class="alert-item"><strong>⚠️ SCALE ERROR:</strong> HX711 amplifier or load cell is disconnected, broken, or not responding. Check wiring and power. Remote dispensing is disabled until resolved.' + '<span class="alert-time">Detected: ' + new Date().toLocaleString() + "</span></div>");
        }

        compartments.forEach(c => {
            if (c.hasError) {
                hasAlert = true;
                list.insertAdjacentHTML("beforeend", '<div class="alert-item"><strong>⚠️ SENSOR ERROR:</strong> ' + c.name + " (" + c.rice + ") ultrasonic sensor is disconnected or malfunctioning. Check wiring and calibration." + '<span class="alert-time">Detected: ' + new Date().toLocaleString() + "</span></div>");
            }
        });

        compartments.forEach(c => {
            if (c.kg !== null && c.kg <= DANGER_THRESHOLD && !c.hasError) {
                hasAlert = true;
                list.insertAdjacentHTML("beforeend", '<div class="alert-item"><strong>CRITICAL:</strong> ' + c.name + " (" + c.rice + ") is dangerously low at <strong>" + c.kg.toFixed(1) + " kg</strong> (Below 1kg threshold). Refill immediately." + '<span class="alert-time">Detected: ' + new Date().toLocaleString() + "</span></div>");
            }
        });

        compartments.forEach(c => {
            if (c.kg !== null && c.kg > DANGER_THRESHOLD && c.kg <= LOW_THRESHOLD && !c.hasError) {
                hasAlert = true;
                list.insertAdjacentHTML("beforeend", '<div class="alert-item"><strong>ADVISORY:</strong> ' + c.name + " (" + c.rice + ") is low at <strong>" + c.kg.toFixed(1) + " kg</strong> (Below 3kg threshold). Prepare refill soon." + '<span class="alert-time">Detected: ' + new Date().toLocaleString() + "</span></div>");
            }
        });

        if (!hasAlert) list.innerHTML = '<div class="alert-item">All compartments are okay. No active warnings.</div>';
    }

    function startMonitoring() {
        try { if ("Notification" in window && Notification.permission === "default") Notification.requestPermission(); } catch (e) {}
        initializeAppAndNetwork();
    }

    window.addEventListener("DOMContentLoaded", function () {
        updateCompartment(1, null, false); updateCompartment(2, null, false); updateCompartment(3, null, false);
        const savedUrl = localStorage.getItem(ESP_URL_KEY);
        if (savedUrl) document.getElementById("espUrl").value = savedUrl;
        startMonitoring();
    });
</script>
</body>
