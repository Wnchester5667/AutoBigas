uint16_t readShiftRegister() {
  digitalWrite(SR_PL, LOW);
  delayMicroseconds(10);
  digitalWrite(SR_PL, HIGH);
  delayMicroseconds(10);
  uint16_t data = 0;
  for (int i = 0; i < 8; i++) {   // ONE chip now = 8 bits
    digitalWrite(SR_CLK, LOW);
    delayMicroseconds(5);
    data = (data << 1) | digitalRead(SR_DATA);
    digitalWrite(SR_CLK, HIGH);
    delayMicroseconds(5);
  }
  return data;
}

