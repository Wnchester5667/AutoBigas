float readLoadCellKg() {
  static float candidateKg = -1.0;
  static byte candidateCount = 0;

  for (int i = 0; i < 3; i++) {
    if (scale.is_ready()) {
      float grams = scale.get_units(10);
      if (grams < 0) grams = 0;
      float currentKg = grams / 1000.0;

      float difference = abs(currentKg - lastGoodKg);

      if (difference < 0.500) {
        lastGoodKg = currentKg;
        candidateKg = -1.0;
        candidateCount = 0;
        return currentKg;
      } else {
        if (candidateKg >= 0.0 && abs(currentKg - candidateKg) < 0.050) {
          candidateCount++;
          if (candidateCount >= 5) {
            lastGoodKg = currentKg;   
            candidateKg = -1.0;
            candidateCount = 0;
            return lastGoodKg;
          }
        } else {
          candidateKg = currentKg;
          candidateCount = 1;
        }
      }
    } else {
      scale.power_down();
      delayMicroseconds(100);
      scale.power_up();
    }
  }
  return lastGoodKg;
}

void processCalCommand(String cmd) {
  cmd.trim();
  if (cmd == "c" || cmd == "C") {
    calStage = 1;
    Serial.println();
    Serial.println(F("=== LOAD CELL CALIBRATION MODE ==="));
    Serial.println(F("Step 1: Remove ALL weight from the scale."));
    Serial.println(F("Step 2: Send the letter: t"));
  } 
  else if (cmd == "t" || cmd == "T") {
    if (calStage >= 1) {
      Serial.println(F("Taring... waiting for HX711..."));
      unsigned long timeout = millis() + 3000;
      while (!scale.is_ready() && millis() < timeout) { delay(10); }
      
      if (scale.is_ready()) {
        scale.tare();
        calStage = 2;
        Serial.println(F("Tared OK (zero set)."));
        Serial.println(F("Step 3: Place your KNOWN weight on the scale (e.g. 160ml water)."));
        Serial.println(F("Step 4: WAIT 3 SECONDS for it to settle, then send the grams: 160"));
      } else {
        Serial.println(F("HX711 not responding! Check DT/SCK wires."));
        calStage = 0;
      }
    }
  } 
  else if (cmd == "x" || cmd == "X") {
    calStage = 0;
    Serial.println(F("Calibration mode OFF."));
  } 
  else if (calStage == 2) {
    float grams = cmd.toFloat();
    if (grams <= 1.0) {
      Serial.println(F("Please send a valid weight in grams bigger than 1, e.g.: 160"));
    } else {
      Serial.println(F("Reading scale... hold still for 2 seconds..."));
      delay(2000); 
      
      if (!scale.is_ready()) {
        scale.power_down();
        delayMicroseconds(100);
        scale.power_up();
        delay(500);
      }

      if (scale.is_ready()) {
        long raw = (long)scale.get_value(20);   
        float newFactor = (float)raw / grams;
        scale.set_scale(newFactor);
        Serial.print(F(">>> NEW calibrationFactor = "));
        Serial.println(newFactor, 2);
        Serial.println(F(">>> Paste that number into the code (calibrationFactor) and upload to save it forever."));
        Serial.println(F(">>> Send 'x' when done."));
        calStage = 3;
      } else {
        Serial.println(F("HX711 is frozen. Unplug ESP32, check wires, and try again."));
      }
    }
  }
}

void handleCalibrationInput() {
  while (Serial.available() > 0) {
    char c = (char)Serial.read();
    if (c == '\n' || c == '\r') {
      if (calBuffer.length() > 0) {
        processCalCommand(calBuffer);
        calBuffer = "";
      }
    } else {
      calBuffer += c;
      if (calBuffer.length() > 32) calBuffer = "";
    }
  }
}

void setup() {
  Serial.begin(115200);
  delay(500);
  Serial.println();
  Serial.println("========================================");
  Serial.println("AUTOBIGAS SYSTEM BOOT");
  Serial.println("========================================");

  tft.init();
  tft.setRotation(1);
  tft.fillScreen(TFT_WHITE);

  pinMode(RELAY_JASMINE, OUTPUT);
  digitalWrite(RELAY_JASMINE, HIGH);
  pinMode(RELAY_SINANDOMENG, OUTPUT);
  digitalWrite(RELAY_SINANDOMENG, HIGH);
  pinMode(RELAY_DINORADO, OUTPUT);
  digitalWrite(RELAY_DINORADO, HIGH);

  pinMode(SR_PL, OUTPUT);
  pinMode(SR_CLK, OUTPUT);
  pinMode(SR_DATA, INPUT);
  digitalWrite(SR_PL, HIGH);
  digitalWrite(SR_CLK, LOW);

  pinMode(TRIG_JASMINE, OUTPUT);
  pinMode(ECHO_JASMINE, INPUT);
  pinMode(TRIG_SINANDOMENG, OUTPUT);
  pinMode(ECHO_SINANDOMENG, INPUT);
  pinMode(TRIG_DINORADO, OUTPUT);
  pinMode(ECHO_DINORADO, INPUT);

  scale.begin(HX711_DT, HX711_SCK);
  unsigned long st = millis();
  while (!scale.is_ready() && millis() - st < 3000) {
    delay(100);
  }
  if (scale.is_ready()) {
    scale.set_scale(calibrationFactor);
    scale.tare();
  }

  WiFi.softAP(ssid, password);
  server.on("/", []() {
    server.send_P(200, "text/html", index_html);
  });
  server.on("/sensors", handleSensors);
  server.begin();

  drawIdleScreen();
  lastDebounce = millis();
  Serial.println("SYSTEM READY");
  Serial.println(F("(Send 'c' in Serial Monitor to calibrate the load cell)"));
  delay(1000);
}

void loop() {
  server.handleClient();
  handleCalibrationInput();

  if (remoteDispenseRequested && currentState == STATE_IDLE) {
    remoteDispenseRequested = false;
    triggerRemoteDispense(remoteCompartment, remoteWeight);
  }

  uint16_t buttons = readShiftRegister();

  if (buttons != lastButtons) {
    lastButtons = buttons;
  }

  if (millis() - lastSRPrint >= 1000) {
    lastSRPrint = millis();
    Serial.print("SR Bits (15..0): ");
    for (int i = 15; i >= 0; i--) Serial.print((buttons >> i) & 1);
    Serial.print("  |  STATE = ");
    Serial.println(currentState);
  }

  // NEW 7-BUTTON MAPPING
  bool btnJasmine     = (buttons & (1 << 0));
  bool btnSinandomeng = (buttons & (1 << 1));
  bool btnDinorado    = (buttons & (1 << 2));
  bool btnCancel      = (buttons & (1 << 3));   // Cancel/Back
  bool btnConfirm     = (buttons & (1 << 4));   // Confirm/Dispense
  bool btnIncrement   = (buttons & (1 << 5));   // Increment (+1kg)
  bool btnDecrement   = (buttons & (1 << 6));   // Decrement (-1kg)

  switch (currentState) {
    case STATE_IDLE:
      checkVarietyButtons(btnJasmine, btnSinandomeng, btnDinorado);
      break;
    case STATE_VARIETY_SELECTED:
      checkWeightButtons(btnIncrement, btnDecrement);
      checkCancelButton(btnCancel);
      checkConfirmButton(btnConfirm);
      break;
    case STATE_READY:
      checkCancelButton(btnCancel);
      checkConfirmButton(btnConfirm);
      break;
    default:
      break;
  }

  checkUltrasonic();
  if (currentState == STATE_IDLE) printLoadCellReading();
}

void handleSensors() {
  server.sendHeader("Access-Control-Allow-Origin", "*");
  if (server.hasArg("dispense") && server.hasArg("weight")) {
    int compId = server.arg("dispense").toInt();
    float weight = server.arg("weight").toFloat();
    if (compId >= 1 && compId <= 3 && weight > 0 && weight <= 10) {
      float avail = (compId == 1) ? jasmineKg : (compId == 2) ? sinandomengKg : dinoradoKg;
      if (weight > avail) {
        server.send(200, "application/json", "{\"status\":\"insufficient_stock\",\"compartment\":" + String(compId) + ",\"available\":" + String(avail, 1) + "}");
        return;
      }
      remoteDispenseRequested = true;
      remoteCompartment = compId;
      remoteWeight = weight;
      server.send(200, "application/json", "{\"status\":\"dispensing\",\"compartment\":" + String(compId) + ",\"weight\":" + String(weight, 1) + "}");
      return;
    }
  }
  String json = "{\"compartment1\":" + String(jasmineKg, 2) + ",\"compartment2\":" + String(sinandomengKg, 2) + ",\"compartment3\":" + String(dinoradoKg, 2) + "}";
  server.send(200, "application/json", json);
}

void triggerRemoteDispense(int compartment, float weightKg) {
  if (compartment == 1) {
    selectedVariety = "Jasmine";
    selectedPricePerKg = PRICE_JASMINE;
  } else if (compartment == 2) {
    selectedVariety = "Sinandomeng";
    selectedPricePerKg = PRICE_SINANDOMENG;
  } else {
    selectedVariety = "Dinorado";
    selectedPricePerKg = PRICE_DINORADO;
  }
  selectedKilo = weightKg;
  currentState = STATE_DISPENSING;
  dispenseRice();
}

float getDistanceCM(int trigPin, int echoPin) {
  digitalWrite(trigPin, LOW);
  delayMicroseconds(2);
  digitalWrite(trigPin, HIGH);
  delayMicroseconds(10);
  digitalWrite(trigPin, LOW);
  long duration = pulseIn(echoPin, HIGH, 30000);
  float distance = (duration * 0.0343) / 2.0;
  if (distance == 0 || distance > 400) distance = 400;
  return distance;
}

float distanceToKg(float distance) {
  if (distance <= BIN_FULL_DISTANCE) return MAX_KG;
  if (distance >= BIN_EMPTY_DISTANCE) return 0;
  return ((BIN_EMPTY_DISTANCE - distance) / (BIN_EMPTY_DISTANCE - BIN_FULL_DISTANCE)) * MAX_KG;
}

void checkUltrasonic() {
  if (millis() - lastUltrasonicCheck < ultrasonicInterval) return;
  lastUltrasonicCheck = millis();
  jasmineKg = distanceToKg(getDistanceCM(TRIG_JASMINE, ECHO_JASMINE));
  sinandomengKg = distanceToKg(getDistanceCM(TRIG_SINANDOMENG, ECHO_SINANDOMENG));
  dinoradoKg = distanceToKg(getDistanceCM(TRIG_DINORADO, ECHO_DINORADO));
}

void printLoadCellReading() {
  if (millis() - lastLoadCellPrint < loadCellPrintInterval) return;
  lastLoadCellPrint = millis();
  loadCellKg = readLoadCellKg();

  if (calStage == 1 || calStage == 2) return;

  Serial.print("Current Weight: ");
  Serial.print(loadCellKg, 3);
  Serial.println(" kg");
}

void checkVarietyButtons(bool bJ, bool bS, bool bD) {
  if (millis() - lastDebounce < debounceDelay) return;
  if (bJ && !prevBtnJasmine) {
    selectedVariety = "Jasmine";
    selectedPricePerKg = PRICE_JASMINE;
    selectedKilo = 1;  // Start at 1kg
    currentState = STATE_VARIETY_SELECTED;
    lastDebounce = millis();
    drawVarietySelectedScreen();
  } else if (bS && !prevBtnSinandomeng) {
    selectedVariety = "Sinandomeng";
    selectedPricePerKg = PRICE_SINANDOMENG;
    selectedKilo = 1;
    currentState = STATE_VARIETY_SELECTED;
    lastDebounce = millis();
    drawVarietySelectedScreen();
  } else if (bD && !prevBtnDinorado) {
    selectedVariety = "Dinorado";
    selectedPricePerKg = PRICE_DINORADO;
    selectedKilo = 1;
    currentState = STATE_VARIETY_SELECTED;
    lastDebounce = millis();
    drawVarietySelectedScreen();
  }
  prevBtnJasmine = bJ;
  prevBtnSinandomeng = bS;
  prevBtnDinorado = bD;
}

void checkWeightButtons(bool bInc, bool bDec) {
  if (millis() - lastDebounce < debounceDelay) return;
  bool changed = false;
  
  if (bInc && !prevBtnIncrement) {
    if (selectedKilo < 10.0) {
      selectedKilo += 1;
      changed = true;
    }
  } else if (bDec && !prevBtnDecrement) {
    if (selectedKilo > 1.0) {
      selectedKilo -= 1;
      changed = true;
    }
  }
  
  if (changed) {
    lastDebounce = millis();
    drawVarietySelectedScreen();
  }
  
  prevBtnIncrement = bInc;
  prevBtnDecrement = bDec;
}

void checkCancelButton(bool bCancel) {
  if (millis() - lastDebounce < debounceDelay) return;
  
  if (bCancel && !prevBtnCancel) {
    lastDebounce = millis();
    
    if (currentState == STATE_VARIETY_SELECTED) {
      // Go back to IDLE
      selectedVariety = "";
      selectedKilo = 0;
      currentState = STATE_IDLE;
      drawIdleScreen();
    } else if (currentState == STATE_READY) {
      // Go back to VARIETY_SELECTED
      currentState = STATE_VARIETY_SELECTED;
      drawVarietySelectedScreen();
    }
  }
  prevBtnCancel = bCancel;
}

void checkConfirmButton(bool bConfirm) {
  if (millis() - lastDebounce < debounceDelay) return;
  
  if (bConfirm && !prevBtnConfirm) {
    lastDebounce = millis();
    
    if (currentState == STATE_VARIETY_SELECTED) {
      // Move to READY state
      currentState = STATE_READY;
      drawReadyScreen();
    } else if (currentState == STATE_READY) {
      // Check stock and dispense
      float avail = stockFor(selectedVariety);
      if (selectedKilo > avail) {
        tft.fillRect(15, 210, 450, 80, TFT_WHITE);
        tft.setTextColor(TFT_RED);
        tft.setTextSize(2);
        tft.setCursor(15, 218);
        tft.print("ERROR: Insufficient Stock!");
        tft.setCursor(15, 255);
        tft.print("Only ");
        tft.print(avail, 1);
        tft.print("kg available.");
        delay(2000);
        drawReadyScreen();
      } else {
        currentState = STATE_DISPENSING;
        dispenseRice();
      }
    }
  }
  prevBtnConfirm = bConfirm;
}

void dispenseRice() {
  drawDispensingScreen();
  float targetKg = selectedKilo;
  int relayPin = RELAY_JASMINE;
  if (selectedVariety == "Sinandomeng") relayPin = RELAY_SINANDOMENG;
  else if (selectedVariety == "Dinorado") relayPin = RELAY_DINORADO;

  digitalWrite(relayPin, LOW);
  if (scale.is_ready()) scale.tare();

  float currentKg = 0;
  unsigned long startTime = millis();
  lastDispPrint = 0;

  // --- CANCEL BUTTON VARIABLES ---
  bool cancelRequested = false;
  uint16_t lastBtnState = readShiftRegister();
  unsigned long cancelDebounce = 0;

  while (currentKg < targetKg) {
    server.handleClient();

    // --- CHECK FOR CANCEL BUTTON PRESS ---
    uint16_t currentBtnState = readShiftRegister();
    bool bCancel = (currentBtnState & (1 << 3)); // Bit 3 is Cancel
    
    // Detect press and start debounce timer
    if (bCancel && !(lastBtnState & (1 << 3))) {
      cancelDebounce = millis();
    }
    // If held for > 100ms, trigger cancel
    if (bCancel && cancelDebounce > 0 && (millis() - cancelDebounce > 100)) {
      cancelRequested = true;
      break; // Exit the dispensing loop immediately
    }
    lastBtnState = currentBtnState;
    // -------------------------------

    if (!scale.is_ready()) {
      if (millis() - lastDispPrint >= 200) {
        lastDispPrint = millis();
        Serial.println("HX711 BLINDED BY NOISE");
      }
    } else {
      currentKg = readLoadCellKg();
      if (millis() - lastDispPrint >= 200) {
        lastDispPrint = millis();
        Serial.print("Weighing: ");
        Serial.print(currentKg, 3);
        Serial.print(" / ");
        Serial.print(targetKg, 3);
        Serial.println(" kg");
      }
    }

    updateDispensingProgress(currentKg, targetKg);
    delay(20);
    if (millis() - startTime > 60000) {
      break;
    }
  }
  
  // IMMEDIATELY CUT POWER TO ALL RELAYS
  digitalWrite(RELAY_JASMINE, HIGH);
  digitalWrite(RELAY_SINANDOMENG, HIGH);
  digitalWrite(RELAY_DINORADO, HIGH);

  tft.init();
  tft.setRotation(1);

  if (cancelRequested) {
    tft.fillScreen(TFT_WHITE);
    // Draw a RED header for Cancelled
    tft.fillRect(0, 0, 480, 60, TFT_RED);
    tft.setTextColor(TFT_WHITE);
    tft.setTextSize(3);
    tft.setCursor(15, 18);
    tft.print("Cancelled");
    
    tft.setTextColor(TFT_RED);
    tft.setTextSize(3);
    tft.setCursor(100, 150);
    tft.print("Dispensing");
    tft.setCursor(120, 190);
    tft.print("Cancelled!");
    
    tft.setTextColor(TFT_BLACK);
    tft.setTextSize(2);
    tft.setCursor(90, 240);
    tft.print("Returning to menu...");
    
    delay(2000);
    
    selectedVariety = "";
    selectedKilo = 0;
    selectedPricePerKg = 0;
    currentState = STATE_IDLE;
    drawIdleScreen();
    return;
  }

  currentState = STATE_DONE;
  drawDoneScreen();
  delay(3000);
  selectedVariety = "";
  selectedKilo = 0;
  selectedPricePerKg = 0;
  currentState = STATE_IDLE;
  drawIdleScreen();
}

